sra format
use tabs: true
use numeric depth: false
-r:Root
	-o:asset
		-v:type
			-s:RenderSettings
		-o:ptr
			-v:appName
				-s:DeathLovers
			-a:presets
				-k:i
					-o:d
						-v:name
							-s:Only geometry MSAA
						-a:shaderDefines
						-v:mainCameraRenderTechnique
							-s:Engine/Render/Geometry.srtech
						-v:editorCameraRenderTechnique
							-s:Editor/Render/GeometryClearTest.srtech
				-k:i
					-o:d
						-v:name
							-s:Empty
						-a:shaderDefines
				-k:i
					-o:d
						-v:name
							-s:Geometry + No debug
						-a:shaderDefines
						-v:mainCameraRenderTechnique
							-s:Engine/Render/Geometry.srtech
						-v:editorCameraRenderTechnique
							-s:Editor/Render/GeometryNoDebug.srtech
				-k:i
					-o:d
						-v:name
							-s:Post process
						-a:shaderDefines
						-v:mainCameraRenderTechnique
							-s:Engine/Render/PostProcess.srtech
						-v:editorCameraRenderTechnique
							-s:Editor/Render/PostProcess.srtech
				-k:i
					-o:d
						-v:name
							-s:Default with game color buffer
						-a:shaderDefines
							-k:i
								-v:d
									-s:SR_DEFINE_USE_CASCADED_SHADOW_MAP
						-v:mainCameraRenderTechnique
							-s:Engine/Render/FullRenderUnusedWithColorBuffer.srtech
						-v:editorCameraRenderTechnique
							-s:Editor/Render/FullRender.srtech
				-k:i
					-o:d
						-v:name
							-s:Default with game color buffer no shadows
						-a:shaderDefines
						-v:mainCameraRenderTechnique
							-s:Engine/Render/FullRenderWithColorBufferNoShadows.srtech
						-v:editorCameraRenderTechnique
							-s:Editor/Render/FullRender.srtech
				-k:i
					-o:d
						-v:name
							-s:Cascades depth debug
						-a:shaderDefines
							-k:i
								-v:d
									-s:SR_DEFINE_USE_CASCADED_SHADOW_MAP
						-v:mainCameraRenderTechnique
							-s:Engine/Render/CascadedMapToScreen.srtech
						-v:editorCameraRenderTechnique
							-s:Editor/Render/FullRender.srtech
				-k:i
					-o:d
						-v:name
							-s:Simple
						-a:shaderDefines
						-v:editorCameraRenderTechnique
							-s:Editor/Render/Simple.srtech
				-k:i
					-o:d
						-v:name
							-s:[Broken] Post process no color pick
						-a:shaderDefines
							-k:i
								-v:d
									-s:SR_DEFINE_USE_CASCADED_SHADOW_MAP
						-v:editorCameraRenderTechnique
							-s:Editor/Render/PostProcessNoColorPick.srtech
				-k:i
					-o:d
						-v:name
							-s:[Broken] Post process instancing
						-a:shaderDefines
							-k:i
								-v:d
									-s:SR_DEFINE_USE_CASCADED_SHADOW_MAP
						-v:mainCameraRenderTechnique
							-s:Engine/Render/PostProcessInstancing.srtech
						-v:editorCameraRenderTechnique
							-s:Engine/Render/PostProcessInstancing.srtech
				-k:i
					-o:d
						-v:name
							-s:Debug cascades map instancing
						-a:shaderDefines
						-v:editorCameraRenderTechnique
							-s:Editor/Render/CascadesToScreenInstancing.srtech
				-k:i
					-o:d
						-v:name
							-s:Debug cascades map
						-a:shaderDefines
						-v:editorCameraRenderTechnique
							-s:Editor/Render/CascadesToScreen.srtech
				-k:i
					-o:d
						-v:name
							-s:Geometry with color pick
						-a:shaderDefines
						-v:editorCameraRenderTechnique
							-s:Editor/Render/GeometryWithColorPick.srtech
			-o:defaultPreset
				-v:name
					-s:Default
				-a:shaderDefines
				-v:mainCameraRenderTechnique
					-s:Engine/Render/Render.srptech
				-v:editorCameraRenderTechnique
					-s:Engine/Render/Render.srptech
			-a:shadowQualityPresets
				-k:item
					-v:first
						-s:Low
					-o:second
						-v:shadowMapResolution
							-i:1024
						-v:cascadesCount
							-i:2
						-v:frustumCount
							-i:0
				-k:item
					-v:first
						-s:Medium
					-o:second
						-v:shadowMapResolution
							-i:2048
						-v:cascadesCount
							-i:3
						-v:frustumCount
							-i:1
				-k:item
					-v:first
						-s:Ultra
					-o:second
						-v:frustumCount
							-i:0
				-k:item
					-v:first
						-s:Extreme
					-o:second
						-v:shadowMapResolution
							-i:8192
						-v:frustumCount
							-i:0
			-a:colorBufferQualityPresets
			-a:SSAOQualityPresets
				-k:item
					-v:first
						-s:None
					-o:second
						-v:preScale
							-f:0
						-v:sampleCount
							-i:0
				-k:item
					-v:first
						-s:Low
					-o:second
						-v:preScale
							-f:0.5
						-v:sampleCount
							-i:32
				-k:item
					-v:first
						-s:Medium
					-o:second
						-v:preScale
							-f:0.7
						-v:sampleCount
							-i:32
				-k:item
					-v:first
						-s:High
					-o:second
			-a:bloomQualityPresets
			-a:SSRQualityPresets
			-a:defaultPlatformGraphicsSettings
				-k:i
					-o:d
						-o:graphics
							-o:framerateLimit
								-v:has
									-b:true
								-v:value
									-i:60
							-v:shadowsInstancing
								-b:false
							-v:postProcess
								-b:false
							-v:hdr
								-b:false
							-v:autoExposure
								-b:false
							-v:textureCompression
								-b:true
							-v:SSAO
								-s:None
							-v:shadowsQuality
								-s:None
							-v:colorBufferQuality
								-s:Medium
							-v:volumetricClouds
								-s:None
							-v:volumetricFog
								-s:None
							-v:bloom
								-s:None
