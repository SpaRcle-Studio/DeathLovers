sra format
use tabs: true
use numeric depth: false
-r:Root
	-o:asset
		-v:type
			-s:FileMaterialResource
		-o:ptr
			-o:data
				-v:type
					-s:MaterialData
				-o:ptr
					-o:defaultShader
						-v:shaderPath
							-s:DeathLovers/Shaders/RuntimeText.srsl
						-a:uniforms
							-k:i
								-o:d
									-v:id
										-s:color
									-v:type
										-s:Vec3
									-o:value
										-v:x
											-f:1
										-v:y
											-f:1
										-v:z
											-f:1
							-k:i
								-o:d
									-v:id
										-s:outlineWidth
									-v:type
										-s:Float
									-v:value
										-f:3
						-a:samplers
