        narrator("{i}К тому же, если меня заменит ИИшка, то это будет в сто раз позорнее.{/i}");
        narrator("{i}Осталось только вспомнить, как вообще общаться с противоположным полом…{/i}");
        narrator("{i}{b}Ей-богу{/b}, театр одного актёра начинается.{/i}");
        narrator("{i}Ну и чего, где первый акт пьесы пройдёт?{/i}");
    }

    // script.rpy:258
    void start()
    {
        call(label_prologue);
        call(main_choice);
    }

    // script.rpy:261
    void main_choice()
    {
        while (true)
        {
            scene("images/background/office.png");
            stop_music();
            stop_sound();
            play_sound("audio/music/office.ogg", true, 1.5);
            play_music("audio/music/main.ogg");
            Menu menu;
            menu.option("В столовую, а то мне без сахарной бомбы тяжело думается.", !v.canteen_visited);
            menu.option("Лучше к курилке у мусорки сходить сначала, после такого без сигаретки тяжко…", !v.landfill_visited);
            menu.option("Cразу к офисам, дай Бог, наткнусь на кого деятельного.", !v.offices_visited);
            switch (menu.show())
            {
                case 0:
                {
                    v.canteen_visited = true;
                    barrier();
                    call(label_canteen);
                    break;
                }
                case 1:
                {
                    v.landfill_visited = true;
                    barrier();
                    call(label_landfill);
                    break;
                }
                case 2:
                {
                    v.offices_visited = true;
                    barrier();
                    call(label_offices);
                    break;
                }
            }
            if (!v.canteen_visited || !v.landfill_visited || !v.offices_visited)
            {
                continue;
            }
            return;
        }
    }
}
