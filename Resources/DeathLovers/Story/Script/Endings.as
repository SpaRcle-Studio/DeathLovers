    void ending()
    {
        barrier();
        play_music("audio/music/god.ogg");
        play_sound("audio/sfx/news.ogg");
        if (v.plague_score < 5 && v.war_score < 5 && v.hunger_score < 5)
        {
            jump(bad_ending);
        }
        scene("images/background/cgall.png", fade());
        news("{cps=*2}Экстренное включение!{/cps}");
        news("{cps=*2}Последний утренний репортаж в вашей жизни! Не проспите главное.{/cps}");
        news("{cps=*2}То есть, последний утренний и последний в целом… в вашей жизни.{/cps}");
        news("{cps=*0.5}Да и в моей тоже…{/cps}");
        news("{cps=*3}В смысле!{/cps} Да и в моей ТОЖЕ! :)");
        if (v.plague_score >= 5 && v.war_score < 5 && v.hunger_score < 5)
        {
            jump(plague_ending);
        }
        if (v.plague_score < 5 && v.war_score >= 5 && v.hunger_score < 5)
        {
            jump(war_ending);
        }
        if (v.plague_score < 5 && v.war_score < 5 && v.hunger_score >= 5)
        {
            jump(hunger_ending);
        }
        if (v.plague_score >= 5 && v.war_score >= 5 && v.hunger_score < 5)
        {
            jump(plaguewar_ending);
        }
        if (v.plague_score >= 5 && v.war_score < 5 && v.hunger_score >= 5)
        {
            jump(plaguehunger_ending);
        }
        if (v.plague_score < 5 && v.war_score >= 5 && v.hunger_score >= 5)
        {
            jump(warhunger_ending);
        }
        if (v.plague_score >= 5 && v.war_score >= 5 && v.hunger_score >= 5)
        {
            jump(harem_ending);
        }
        jump(plague_ending);
    }

