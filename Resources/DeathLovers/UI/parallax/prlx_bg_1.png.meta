sra format
use tabs: true
use numeric depth: false
-r:Root
	-v:content
		-s:Illustration
	-v:compressionPolicy
		-s:HighQuality
	-v:imageType
		-s:UI
	-v:filter
		-s:NEAREST
	-v:mipLevels
		-i:1
	-v:addressMode
		-s:ClampToEdge
	-v:imageType
		-s:UI
	-v:mipLevels
		-i:1
	-v:addressMode
		-s:ClampToEdge
