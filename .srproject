sra format
use tabs: true
use numeric depth: false
-r:Root
	-o:asset
		-v:type
			-s:ProjectSettings
		-o:ptr
			-v:projectName
				-s:DeathLovers
			-v:mainScene
				-s:DeathLovers/Scenes/MainMenu.scene
			-a:packages
			-a:buildProfiles
				-k:i
					-o:d
						-v:name
							-s:DeathLovers
			-v:enableCppScripts
				-b:false
